<% config = @ai_agent.agent_configuration %>
<% status_class = case @ai_agent.operational_status
   when "active" then "bg-emerald-100 text-emerald-700"
   when "paused"  then "bg-amber-100 text-amber-700"
   when "draft"   then "bg-stone-100 text-stone-600"
   else "bg-stone-100 text-stone-500"
   end %>

<div class="mx-auto max-w-3xl">
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight"><%= @ai_agent.name %></h1>
        <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-bold text-indigo-700">AI</span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold <%= status_class %>">
          <span class="size-1.5 rounded-full <%= @ai_agent.operational_status == 'active' ? 'bg-emerald-500' : @ai_agent.operational_status == 'paused' ? 'bg-amber-500' : 'bg-stone-400' %>"></span>
          <%= @ai_agent.operational_status.capitalize %>
        </span>
      </div>
      <p class="mt-1 text-sm text-stone-500"><%= config&.role || "No role set" %></p>
    </div>

    <div class="flex items-center gap-2">
      <% if @ai_agent.operational_status == "active" %>
        <%= button_to "Pause", deactivate_account_ai_agent_path(current_account, @ai_agent), method: :post,
              data: { turbo_confirm: "Pause #{@ai_agent.name}? Owned conversations will remain assigned but the agent will not take new actions." },
              class: "rounded-lg border border-amber-200 px-3 py-1.5 text-sm font-medium text-amber-700 hover:bg-amber-50" %>
      <% elsif @ai_agent.operational_status == "paused" || @ai_agent.operational_status == "draft" %>
        <%= button_to "Activate", activate_account_ai_agent_path(current_account, @ai_agent), method: :post,
              class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-700" %>
      <% end %>
      <%= link_to "Edit", edit_account_ai_agent_path(current_account, @ai_agent),
            class: "rounded-lg border border-stone-200 px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-stone-50" %>
    </div>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-3">
    <!-- Instructions -->
    <section class="rounded-2xl border border-stone-200 bg-white p-5 md:col-span-2">
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-stone-400">Instructions</h2>
      <div class="mt-3">
        <% if config&.guidance_config&.dig("instructions").present? %>
          <pre class="whitespace-pre-wrap text-sm leading-relaxed text-stone-700 font-mono"><%= config.guidance_config["instructions"] %></pre>
        <% else %>
          <p class="text-sm italic text-stone-400">No instructions configured. Edit this agent to add instructions.</p>
        <% end %>
      </div>
    </section>

    <!-- Side info -->
    <div class="space-y-4">
      <section class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-stone-400">Activity</h2>
        <div class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-stone-500">Owned conversations</span>
            <span class="font-semibold text-stone-800"><%= @ai_agent.owned_conversations.active.count %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-stone-500">Total runs</span>
            <span class="font-semibold text-stone-800"><%= @ai_agent.ai_runs.count %></span>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-stone-400">Teams</h2>
        <% if @ai_agent.teams.any? %>
          <ul class="mt-2 space-y-1">
            <% @ai_agent.teams.each do |team| %>
              <li class="text-sm text-stone-600"><%= team.name %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-stone-400">Not a member of any team.</p>
        <% end %>
      </section>
    </div>
  </div>

  <!-- Testing -->
  <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-stone-400">Test</h2>
        <p class="mt-1 text-sm text-stone-500">See how this agent responds to a customer message without affecting real conversations.</p>
      </div>
      <%= link_to "Run test", preview_account_ai_agent_path(current_account, @ai_agent),
            class: "rounded-lg border border-indigo-200 px-3 py-1.5 text-sm font-semibold text-indigo-600 hover:bg-indigo-50" %>
    </div>
  </section>
</div>