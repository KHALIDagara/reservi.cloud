<%# Collaborative appointment booking component %>
<%# Locals: conversation, role_key, role_label, appointment (existing or nil), scheduled_agent (existing or nil) %>

<div class="space-y-3" data-controller="appointment-booking"
     data-appointment-booking-account-id-value="<%= current_account.id %>"
     data-appointment-booking-conversation-id-value="<%= conversation.id %>"
     data-appointment-booking-role-key-value="<%= role_key %>"
     data-appointment-booking-form-action-value="<%= book_appointments_path(current_account) %>"
     data-appointment-booking-availability-url-value="<%= availability_appointments_path(current_account) %>">

  <% if local_assigns[:appointment].present? && appointment&.confirmed? %>
    <%# ── Existing confirmed appointment display ── %>
    <div class="rounded-xl bg-emerald-50 p-3">
      <div class="flex items-start justify-between gap-2">
        <div>
          <p class="text-sm font-semibold text-emerald-800">
            <%= appointment.starts_at.in_time_zone(appointment.timezone)&.strftime("%a, %d %b · %H:%M") %>
            &mdash;
            <%= (appointment.starts_at + appointment.duration_minutes.minutes).in_time_zone(appointment.timezone)&.strftime("%H:%M") %>
          </p>
          <% if appointment.scheduled_agent %>
            <p class="mt-0.5 text-xs text-emerald-600">
              With <span class="font-semibold"><%= appointment.scheduled_agent.name %></span>
            </p>
          <% end %>
          <p class="mt-0.5 text-xs text-emerald-500"><%= appointment.timezone %></p>
        </div>
        <span class="rounded-full bg-emerald-200 px-2 py-0.5 text-[0.68rem] font-bold text-emerald-800">Confirmed</span>
      </div>

      <%# Action buttons %>
      <div class="mt-3 flex flex-wrap gap-2">
        <%# Owner can reschedule %>
        <% if conversation.owner_id == current_membership.agent.id %>
          <button type="button"
                  data-action="click->appointment-booking#openReschedule"
                  data-appointment-booking-appointment-id-param="<%= appointment.id %>"
                  class="min-h-9 rounded-lg border border-indigo-200 bg-white px-3 text-xs font-bold text-indigo-600 hover:bg-indigo-50">
            Reschedule
          </button>
        <% end %>

        <%# Any member can change status %>
        <%= button_to "Mark Complete",
              change_status_appointment_path(current_account, appointment),
              method: :post,
              params: { status: "completed" },
              class: "min-h-9 rounded-lg border border-slate-200 bg-white px-3 text-xs font-bold text-slate-600 hover:bg-slate-50" %>

        <%= button_to "No-show",
              change_status_appointment_path(current_account, appointment),
              method: :post,
              params: { status: "no_show" },
              class: "min-h-9 rounded-lg border border-rose-200 bg-white px-3 text-xs font-bold text-rose-600 hover:bg-rose-50" %>

        <%= button_to "Cancel",
              change_status_appointment_path(current_account, appointment),
              method: :post,
              params: { status: "cancelled" },
              class: "min-h-9 rounded-lg border border-rose-200 bg-white px-3 text-xs font-bold text-rose-600 hover:bg-rose-50" %>

        <%# Take over conversation %>
        <% if conversation.owner_id != current_membership.agent.id %>
          <%= button_to "Take over #",
                takeover_conversation_appointment_path(current_account, appointment, conversation_id: conversation.id),
                method: :post,
                class: "min-h-9 rounded-lg bg-indigo-600 px-3 text-xs font-bold text-white hover:bg-indigo-700" %>
        <% end %>
      </div>

      <%# Reassign dropdown %>
      <div class="mt-2">
        <details class="group">
          <summary class="cursor-pointer text-xs font-semibold text-slate-500 hover:text-slate-700">Reassign &hellip;</summary>
          <div class="mt-2">
            <%= form_with url: reassign_appointment_path(current_account, appointment), method: :post, class: "flex flex-col gap-2" do |f| %>
              <%= f.select :scheduled_agent_id,
                    current_account.agents.schedulable.order(:name).map { |a| [a.name, a.id] },
                    { selected: appointment.scheduled_agent_id },
                    class: "min-h-10 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none focus:border-indigo-300" %>
              <%= f.submit "Reassign",
                    class: "min-h-9 cursor-pointer rounded-xl bg-slate-900 px-3 text-xs font-bold text-white hover:bg-slate-700" %>
            <% end %>
          </div>
        </details>
      </div>
    </div>

  <% else %>
    <%# ── New booking flow ── %>
    <% if local_assigns[:appointment].present? && appointment&.cancelled? %>
      <p class="text-xs text-slate-400">Previous appointment cancelled</p>
    <% end %>

    <p class="text-xs font-bold text-slate-600"><%= local_assigns[:role_label].presence || role_key.titleize %></p>

    <div class="rounded-xl border border-slate-200 bg-white p-3">
      <%# Agent picker dropdown %>
      <div class="mb-3">
        <label class="block text-[0.68rem] font-bold uppercase tracking-wide text-slate-400 mb-2">Select agent</label>
        <select data-appointment-booking-target="agentSelect"
                data-action="change->appointment-booking#agentChanged"
                class="min-h-10 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none focus:border-indigo-300">
          <option value="">Choose an agent&hellip;</option>
          <% current_account.agents.schedulable.order(:name).each do |agent| %>
            <option value="<%= agent.id %>"><%= agent.name %></option>
          <% end %>
        </select>
      </div>

      <%# Loading state %>
      <div data-appointment-booking-target="loading" class="hidden py-4 text-center">
        <p class="text-sm text-slate-400">Loading availability&hellip;</p>
      </div>

      <%# Error state %>
      <div data-appointment-booking-target="error" class="hidden rounded-lg bg-rose-50 p-3 text-sm text-rose-700"></div>

      <%# Available days + slots (shown after agent is selected) %>
      <div data-appointment-booking-target="daysPanel" class="hidden">
        <label class="block text-[0.68rem] font-bold uppercase tracking-wide text-slate-400 mb-2">Available days</label>
        <div data-appointment-booking-target="daysList" class="flex flex-wrap gap-1.5 mb-3">
          <%# Populated by Stimulus %>
        </div>

        <div data-appointment-booking-target="slotsPanel" class="hidden">
          <label class="block text-[0.68rem] font-bold uppercase tracking-wide text-slate-400 mb-2">Available times</label>
          <div data-appointment-booking-target="slotsList" class="flex flex-wrap gap-1.5 mb-3">
            <%# Populated by Stimulus %>
          </div>
        </div>
      </div>

      <%# Hidden form for booking %>
      <%= form_with url: book_appointments_path(current_account),
            method: :post,
            html: { class: "hidden", data: { appointment_booking_target: "form" } } do |f| %>
        <%= f.hidden_field :conversation_id, value: conversation.id %>
        <%= f.hidden_field :role_key, value: role_key %>
        <%= f.hidden_field :scheduled_agent_id, data: { appointment_booking_target: "scheduledAgentField" } %>
        <%= f.hidden_field :starts_at, data: { appointment_booking_target: "startsAtField" } %>
        <%= f.hidden_field :duration_minutes, value: 60 %>
        <%= f.hidden_field :operation_key, data: { appointment_booking_target: "operationKeyField" } %>
        <%= f.submit "Book", class: "min-h-10 w-full cursor-pointer rounded-xl bg-indigo-600 px-3 text-sm font-bold text-white hover:bg-indigo-700" %>
      <% end %>

      <%# Show selected slot summary and submit button (outside hidden form to have proper visibility) %>
      <div data-appointment-booking-target="summary" class="hidden rounded-xl bg-indigo-50 p-3">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-indigo-800" data-appointment-booking-target="summaryDate"></p>
            <p class="text-xs text-indigo-600" data-appointment-booking-target="summaryTime"></p>
            <p class="text-xs text-indigo-500" data-appointment-booking-target="summaryAgent"></p>
          </div>
          <button type="button"
                  data-action="click->appointment-booking#submitBooking"
                  class="min-h-10 rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white hover:bg-indigo-700">
            Book
          </button>
        </div>
      </div>

      <%# Reschedule dialog (hidden) %>
      <div data-appointment-booking-target="reschedulePanel" class="hidden space-y-3">
        <p class="text-sm font-semibold text-slate-700">Reschedule</p>
        <p class="text-xs text-slate-500">
          Current: <span data-appointment-booking-target="rescheduleCurrent"></span>
        </p>
        <div data-appointment-booking-target="rescheduleDaysList" class="flex flex-wrap gap-1.5">
          <%# Populated by Stimulus %>
        </div>
        <div data-appointment-booking-target="rescheduleSlotsList" class="flex flex-wrap gap-1.5">
          <%# Populated by Stimulus %>
        </div>
        <div data-appointment-booking-target="rescheduleSummary" class="hidden rounded-xl bg-indigo-50 p-3">
          <button type="button"
                  data-action="click->appointment-booking#submitReschedule"
                  class="min-h-10 w-full rounded-xl bg-indigo-600 px-3 text-sm font-bold text-white hover:bg-indigo-700">
            Confirm reschedule
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>