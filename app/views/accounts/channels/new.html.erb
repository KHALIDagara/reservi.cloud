<div class="mx-auto max-w-3xl">
  <%= link_to "← Back to inboxes", account_channels_path(current_account), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mt-6">
    <p class="text-sm font-semibold text-indigo-600">Connect inbox</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Where do customers message you?</h1>
    <p class="mt-2 text-sm text-slate-500">Choose a provider. You’ll sign in securely on the next step.</p>
  </div>

  <div class="mt-7 grid gap-4 sm:grid-cols-2">
    <%= link_to setup_account_channel_path(current_account, provider: "whatsapp"), class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md" do %>
      <span class="flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"><%= app_icon(:inbox, class_name: "size-6") %></span>
      <h2 class="mt-5 text-lg font-bold text-slate-900">WhatsApp</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Connect a WhatsApp Business number with Meta Embedded Signup.</p>
      <span class="mt-5 block text-sm font-bold text-emerald-600">Continue with WhatsApp →</span>
    <% end %>

    <%= link_to setup_account_channel_path(current_account, provider: "instagram"), class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-fuchsia-300 hover:shadow-md" do %>
      <span class="flex size-12 items-center justify-center rounded-2xl bg-fuchsia-50 text-fuchsia-600"><%= app_icon(:inbox, class_name: "size-6") %></span>
      <h2 class="mt-5 text-lg font-bold text-slate-900">Instagram</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Connect professional Instagram messages through secure OAuth.</p>
      <span class="mt-5 block text-sm font-bold text-fuchsia-600">Continue with Instagram →</span>
    <% end %>
  </div>
</div>
