<%# Panel show — renders inside turbo_frame_tag "conversation_panel" %>
<%# This is the entry point: it dispatches to block partials based on stage config.
    # Accepts both locals and ivars for dual rendering (controller sets ivars, job passes locals). %>
<%
  stage       ||= @stage
  conversation ||= @conversation
  account_agents ||= @account_agents
  stage_history ||= @stage_history
  customer_fields ||= @customer_fields
  conversation_fields ||= @conversation_fields
  catalogs ||= @catalogs
  item_selections ||= @item_selections
  catalog_roles ||= @catalog_roles
  appointments ||= @appointments
  stage_blocks = local_assigns.fetch(:stage_blocks, @stage_blocks) || []
%>

<%= turbo_frame_tag "conversation_panel" do %>
  <div class="space-y-5 p-4 sm:p-5">
    <%= render "accounts/inboxes/conversations/panel/stage", stage: stage, conversation: conversation %>
    <%= render "accounts/inboxes/conversations/panel/assignment", conversation: conversation, agents: account_agents %>
    <%= render "accounts/inboxes/conversations/panel/stage_history", transitions: stage_history, current_stage: stage %>

    <% stage_blocks.each do |block| %>
      <% case block["type"] %>
      <% when "field" %>
        <%= render "accounts/inboxes/conversations/panel/blocks/field", block: block, conversation: conversation,
              customer_fields: customer_fields, conversation_fields: conversation_fields %>
      <% when "catalog" %>
        <%= render "accounts/inboxes/conversations/panel/blocks/catalog", block: block, conversation: conversation,
              catalogs: catalogs, item_selections: item_selections, catalog_roles: catalog_roles %>
      <% when "appointment" %>
        <%= render "accounts/inboxes/conversations/panel/blocks/appointment", block: block, conversation: conversation,
              appointments: appointments %>
      <% end %>
    <% end %>
  </div>
<% end %>