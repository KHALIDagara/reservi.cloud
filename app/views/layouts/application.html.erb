<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reservi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Reservi">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <a href="#main-content" class="sr-only z-50 rounded-lg bg-white px-4 py-2 font-semibold text-indigo-700 focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Skip to content</a>

    <% if authenticated? && current_account %>
      <%= render "shared/app_sidebar" %>
      <%= render "shared/mobile_app_navigation" %>
      <div class="min-h-screen lg:pl-64">
        <main id="main-content" class="<%= content_for?(:main_class) ? yield(:main_class) : 'mx-auto w-full max-w-6xl px-4 pb-28 pt-6 sm:px-6 sm:pt-8 lg:px-8 lg:pb-10' %>">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <% if authenticated? %>
        <header class="border-b border-slate-200 bg-white">
          <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
            <%= link_to root_path, class: "flex items-center gap-2.5 font-bold tracking-tight" do %>
              <span class="flex size-8 items-center justify-center rounded-xl bg-indigo-600 text-xs text-white">R</span> Reservi
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>
          </nav>
        </header>
      <% end %>
      <main id="main-content" class="<%= content_for?(:main_class) ? yield(:main_class) : 'mx-auto w-full max-w-3xl px-4 py-8 sm:px-6' %>">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
