<% content_for :title, "Settings · #{@inbox.name} · Reservi" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "← Back to inbox", inbox_path(current_account, @inbox), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold capitalize text-indigo-600"><%= @inbox.provider_type %> inbox</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950"><%= @inbox.name %></h1>
      </div>
      <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700"><%= @inbox.active? ? "Connected" : "Inactive" %></span>
    </div>

    <dl class="mt-7 divide-y divide-slate-100 rounded-xl border border-slate-200">
      <div class="px-4 py-3">
        <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Provider account</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-700"><%= @inbox.provider_config["username"] || @inbox.provider_config["display_phone_number"] || @inbox.provider_config["instagram_id"] || @inbox.provider_config["phone_number_id"] %></dd>
      </div>
      <div class="px-4 py-3">
        <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Webhook URL</dt>
        <dd class="mt-1 break-all font-mono text-xs text-slate-600"><%= @inbox.provider_type == "whatsapp" ? meta_whatsapp_webhook_events_url : meta_instagram_webhook_events_url %></dd>
      </div>
    </dl>

    <section class="mt-8">
      <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-slate-600">Default assignment</h3>
      <p class="mt-1 text-xs text-slate-500">New conversations from this inbox are automatically assigned when this is set.</p>
      <%= form_with model: @inbox, url: account_inbox_path(current_account, @inbox), method: :patch, class: "mt-4 space-y-3" do |f| %>
        <div class="flex flex-wrap gap-2">
          <label class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50">
            <%= radio_button_tag "channel[default_assignment_type]", "none", @inbox.default_agent_id.nil? && @inbox.default_team_id.nil?, class: "text-indigo-600" %>
            Unassigned
          </label>
          <label class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50">
            <%= radio_button_tag "channel[default_assignment_type]", "agent", @inbox.default_agent_id.present?, class: "text-indigo-600" %>
            Agent
          </label>
          <label class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50">
            <%= radio_button_tag "channel[default_assignment_type]", "team", @inbox.default_team_id.present?, class: "text-indigo-600" %>
            Team
          </label>
        </div>

        <div class="flex gap-3">
          <div class="min-w-0 flex-1">
            <%= select_tag "channel[default_agent_id]",
                  options_from_collection_for_select(@assignable_agents, "id", "name", @inbox.default_agent_id),
                  include_blank: true,
                  class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-indigo-400",
                  disabled: @inbox.default_agent_id.nil? %>
          </div>
          <div class="min-w-0 flex-1">
            <%= select_tag "channel[default_team_id]",
                  options_from_collection_for_select(@teams, "id", "name", @inbox.default_team_id),
                  include_blank: true,
                  class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-indigo-400",
                  disabled: @inbox.default_team_id.nil? %>
          </div>
          <%= f.submit "Save", class: "mt-1 shrink-0 cursor-pointer rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
        </div>
      <% end %>
    </section>

    <div class="mt-6 flex gap-3">
      <%= link_to "← Back to inbox", inbox_path(current_account, @inbox), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
      <%= button_to "Delete inbox", inbox_path(current_account, @inbox),
            method: :delete,
            class: "rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-600 hover:bg-rose-50",
            form: { data: { turbo_confirm: "Are you sure you want to delete this inbox? It will be deactivated and stop receiving messages." } } %>
    </div>
  </div>
</div>