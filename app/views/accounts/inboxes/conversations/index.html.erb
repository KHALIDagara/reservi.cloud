<%# Inboxes::Conversations index — conversation list for a specific inbox %>
<%# Rendered inside turbo_frame_tag "conversation_list" %>
<%# Each row uses virtual attributes from Inboxes::ConversationListQuery %>

<%= turbo_frame_tag "conversation_list" do %>
  <div class="app-scrollbar flex-1 overflow-y-auto">
    <% if @conversations.any? %>
      <ul class="divide-y divide-slate-100">
        <% @conversations.each do |conversation| %>
          <%= render "conversation_row", conversation:, selected_id: params[:id], filter: params[:filter] %>
        <% end %>
      </ul>
      <% if @next_cursor %>
        <div class="border-t border-slate-100 p-3 text-center">
          <%= link_to "Load more", inbox_conversations_path(current_account, @inbox, before: @next_cursor, filter: params[:filter]),
                class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700",
                data: { turbo_frame: "conversation_list" } %>
        </div>
      <% end %>
    <% else %>
      <div class="p-6 text-center">
        <p class="text-sm text-slate-500">No conversations here</p>
      </div>
    <% end %>
  </div>
<% end %>