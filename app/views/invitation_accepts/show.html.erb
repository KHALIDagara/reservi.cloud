<p class="text-stone-600">
  <%= @invitation.account.name %> has invited
  <strong><%= Current.user.email_address %></strong> to join as
  <strong><%= @role %></strong>.
</p>

<% if @teams.any? %>
  <p class="mt-2 text-sm text-stone-500">
    Teams: <%= @teams.map(&:name).join(", ") %>.
  </p>
<% end %>

<%= button_to "Accept invitation",
              accept_invitation_path(token: @token),
              method: :post,
              class: "mt-6 w-full rounded-md bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700 sm:w-auto" %>
<p class="mt-3 text-sm text-stone-500">
  Accepted invitations cannot be revoked retroactively; access follows your role and team membership.
</p>