<div class="mx-auto max-w-3xl">
  <%= link_to "← Back to inboxes", inboxes_path(current_account), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold capitalize text-indigo-600"><%= @channel.provider_type %> inbox</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950"><%= @channel.name %></h1>
      </div>
      <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700"><%= @channel.active? ? "Connected" : "Inactive" %></span>
    </div>
    <dl class="mt-7 divide-y divide-slate-100 rounded-xl border border-slate-200">
      <div class="px-4 py-3">
        <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Provider account</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-700"><%= @channel.provider_config["username"] || @channel.provider_config["display_phone_number"] || @channel.provider_config["instagram_id"] || @channel.provider_config["phone_number_id"] %></dd>
      </div>
      <div class="px-4 py-3">
        <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">Webhook URL</dt>
        <dd class="mt-1 break-all font-mono text-xs text-slate-600"><%= @channel.provider_type == "whatsapp" ? meta_whatsapp_webhook_events_url : meta_instagram_webhook_events_url %></dd>
      </div>
    </dl>
    <div class="mt-6 flex gap-3">
      <%= link_to "← Back to inboxes", inboxes_path(current_account), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
      <%= button_to "Delete inbox", inbox_path(current_account, @inbox),
            method: :delete,
            class: "rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-600 hover:bg-rose-50",
            form: { data: { turbo_confirm: "Are you sure you want to delete this inbox? It will be deactivated and stop receiving messages." } } %>
    </div>
  </div>
</div>
