<h1 class="text-2xl font-semibold tracking-tight">New Catalog</h1>

<%= form_with model: @catalog, url: catalogs_path(account_id: current_account), class: "mt-6 max-w-md space-y-4" do |f| %>
  <div>
    <%= f.label :title, class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_field :title, required: true, class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 text-sm shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" %>
  </div>

  <%= f.submit "Create Catalog", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
<% end %>

<%= link_to "Back", catalogs_path(account_id: current_account), class: "mt-4 inline-block text-sm text-stone-600 hover:text-stone-900" %>