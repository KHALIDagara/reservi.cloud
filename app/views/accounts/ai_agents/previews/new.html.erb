<div class="mx-auto max-w-2xl">
  <div class="flex items-center gap-3">
    <%= link_to account_ai_agent_path(current_account, @ai_agent), class: "text-stone-400 hover:text-stone-600" do %>
      ←
    <% end %>
    <h1 class="text-2xl font-semibold tracking-tight">Test <%= @ai_agent.name %></h1>
  </div>
  <p class="mt-1 text-sm text-stone-500">Simulate a customer message to see how the agent responds. No real conversations are affected.</p>

  <%= form_with url: run_preview_account_ai_agent_path(current_account, @ai_agent), method: :post, class: "mt-8" do |f| %>
    <div>
      <%= f.label :user_message, "Customer message", class: "block text-sm font-semibold text-stone-700" %>
      <%= f.text_area :user_message, rows: 5, required: true, autofocus: true,
            placeholder: "e.g. Hi, I need someone to redo my garden. Can you help?",
            class: "mt-1.5 block w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
    </div>
    <div class="mt-4">
      <%= f.submit "Run test", class: "cursor-pointer rounded-xl bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-stone-700" %>
    </div>
  <% end %>
</div>