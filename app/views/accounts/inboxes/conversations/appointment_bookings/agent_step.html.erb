<%# Agent step — select the person who will handle this appointment %>
<%# Locals: @role_key, @conversation, @inbox, @schedulable_agents, @existing %>

<%= turbo_frame_tag "conversation_modal" do %>
  <div class="p-5">
    <h2 class="text-base font-bold text-slate-900">Book <%= @role_key.titleize %></h2>
    <p class="mt-0.5 text-xs text-slate-500">Step 1 of 3 · Choose who handles this appointment</p>

    <% if @schedulable_agents.any? %>
      <ul class="mt-4 space-y-1">
        <% @schedulable_agents.each do |agent| %>
          <li>
            <%= link_to agent.name,
                  inbox_conversation_appointment_booking_path(current_account, @inbox, @conversation, role_key: @role_key, step: "day", agent_id: agent.id),
                  data: { turbo_frame: "conversation_modal" },
                  class: "block rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-indigo-50 transition" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate-400">No schedulable agents available.</p>
    <% end %>
  </div>
<% end %>