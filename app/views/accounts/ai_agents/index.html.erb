<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">AI Agents</h1>
  <%= link_to "Create AI agent", new_account_ai_agent_path(current_account), class: "rounded-md bg-stone-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-stone-700" %>
</div>

<% if @ai_agents.any? %>
  <section class="mt-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @ai_agents.each do |agent| %>
        <div class="rounded-xl border <%= agent.operational_status == 'active' && agent.agent_configuration&.published? ? 'border-emerald-200 bg-emerald-50/30' : 'border-stone-200 bg-white' %> p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="size-2 rounded-full <%= agent.active_for_work? ? 'bg-emerald-500' : agent.operational_status == 'draft' ? 'bg-amber-400' : 'bg-stone-400' %>"></span>
                <h3 class="truncate font-semibold text-stone-900"><%= agent.name %></h3>
              </div>
              <p class="mt-0.5 text-xs capitalize text-stone-500"><%= agent.operational_status %></p>
            </div>
            <span class="shrink-0 rounded-full bg-indigo-100 px-2 py-0.5 text-[0.65rem] font-bold text-indigo-700">AI</span>
          </div>

          <div class="mt-3">
            <% config = agent.agent_configuration %>
            <% if config&.guidance_config&.dig("instructions").present? %>
              <p class="line-clamp-3 text-xs text-stone-600"><%= truncate(config.guidance_config["instructions"], length: 120) %></p>
            <% else %>
              <p class="text-xs italic text-stone-400">No instructions configured.</p>
            <% end %>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-stone-200 pt-3">
            <%= link_to "Configure", account_ai_agent_path(current_account, agent), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
            <% if agent.active_for_work? %>
              <%= button_to "Pause", deactivate_account_ai_agent_path(current_account, agent), method: :post,
                    class: "rounded-md border border-amber-200 px-2 py-1 text-xs font-medium text-amber-700 hover:bg-amber-50" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% else %>
  <div class="mt-8 rounded-xl border border-dashed border-stone-300 bg-white p-10 text-center">
    <p class="text-stone-500">No AI agents configured yet.</p>
    <p class="mt-1 text-sm text-stone-400">Create an AI agent to automate conversations through your Flows.</p>
    <div class="mt-6">
      <%= link_to "Create your first AI agent", new_account_ai_agent_path(current_account), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
    </div>
  </div>
<% end %>