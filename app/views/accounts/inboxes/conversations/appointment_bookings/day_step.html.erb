<%# Day step — choose a date for the appointment %>
<%# Locals: @role_key, @conversation, @inbox, @selected_agent, @available_days, @existing %>

<%= turbo_frame_tag "conversation_modal" do %>
  <div class="p-5">
    <div class="mb-4 flex items-center gap-3">
      <%= link_to "← Back",
            inbox_conversation_appointment_booking_path(current_account, @inbox, @conversation, role_key: @role_key, step: "agent"),
            data: { turbo_frame: "conversation_modal" },
            class: "text-xs font-semibold text-slate-400 hover:text-slate-600" %>
      <div>
        <h2 class="text-base font-bold text-slate-900"><%= @role_key.titleize %></h2>
        <p class="mt-0.5 text-xs text-slate-500">Step 2 of 3 · With <%= @selected_agent.name %></p>
      </div>
    </div>

    <ul class="space-y-1">
      <% @available_days.each do |day| %>
        <% day_name = day.strftime("%A, %d %B %Y") %>
        <% is_today = day == Date.current %>
        <li>
          <%= link_to day_name,
                inbox_conversation_appointment_booking_path(current_account, @inbox, @conversation, role_key: @role_key, step: "confirm", agent_id: @selected_agent.id, date: day.to_s),
                data: { turbo_frame: "conversation_modal" },
                class: "block rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-indigo-50 transition #{is_today ? 'bg-indigo-50/50 ring-1 ring-indigo-100' : ''}" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>