<% content_for :title, "#{@inbox.name} · Reservi" %>
<% content_for :main_class, "w-full px-0" %>

<div class="inbox-workspace flex h-[calc(100dvh-4rem)]">
  <%# ── LEFT COLUMN: Conversation list ───────────────────────────────── %>
  <aside class="conversation-list w-80 shrink-0 overflow-hidden border-r border-slate-200 bg-white lg:w-88">
    <div class="flex h-full flex-col">
      <div class="border-b border-slate-200 px-4 py-3">
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <h1 class="truncate text-lg font-bold tracking-tight text-slate-950"><%= @inbox.name %></h1>
            <p class="truncate text-xs capitalize text-slate-400"><%= @inbox.provider_type %></p>
          </div>
          <div class="flex shrink-0 items-center gap-1">
            <%= link_to "Settings", inbox_settings_path(current_account, @inbox),
                  class: "rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-500 hover:bg-slate-100 hover:text-slate-800",
                  data: { turbo: false } if current_membership.admin? %>

            <%= link_to new_account_conversation_path(current_account),
                  class: "flex size-9 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm hover:bg-indigo-700",
                  aria: { label: "New conversation" } do %>
              <%= app_icon(:plus, class_name: "size-4") %>
            <% end %>
          </div>
        </div>
        <nav class="mt-2 flex gap-1" aria-label="Inbox filters">
          <% [["All", nil], ["Mine", "mine"], ["Unowned", "unowned"], ["Team", "team"]].each do |label, filter| %>
            <% active = params[:filter].presence == filter %>
            <%= link_to label, account_inbox_conversations_path(current_account, @inbox, filter: filter),
                  class: "whitespace-nowrap rounded-lg px-2.5 py-1.5 text-xs font-semibold transition #{active ? 'bg-indigo-600 text-white' : 'text-slate-500 hover:bg-slate-100 hover:text-slate-800'}",
                  data: { turbo_frame: "conversation_list" } %>
          <% end %>
        </nav>
      </div>

      <%= turbo_frame_tag "conversation_list",
            src: account_inbox_conversations_path(current_account, @inbox, filter: params[:filter]),
            loading: :eager do %>
        <div class="p-6 text-center">
          <p class="text-sm text-slate-400">Loading conversations…</p>
        </div>
      <% end %>
    </div>
  </aside>

  <%# ── CENTER COLUMN: Conversation detail ───────────────────────────── %>
  <main class="flex min-w-0 flex-1 flex-col bg-slate-50">
    <%= turbo_frame_tag "conversation_workspace" do %>
      <div class="flex h-full flex-col items-center justify-center px-6 text-center">
        <span class="flex size-16 items-center justify-center rounded-2xl bg-white text-slate-300 shadow-sm ring-1 ring-slate-200">
          <%= app_icon(:inbox, class_name: "size-8") %>
        </span>
        <h2 class="mt-5 text-lg font-bold text-slate-700">Select a conversation</h2>
        <p class="mt-1 text-sm text-slate-500">Choose a conversation from the list to view messages and manage the request.</p>
      </div>
    <% end %>
  </main>
</div>

<%# Subscribe to realtime updates for this inbox %>
<%= turbo_stream_from Accounts::InboxChannel, [current_account, @inbox, Current.user] %>

<%# Modal dialog for field editing, catalog selection, appointment booking %>
<div data-controller="modal"
     data-action="keydown.esc@window->modal#closeOnEscape"
     class="hidden fixed inset-0 z-50"
     aria-hidden="true"
     role="dialog"
     aria-modal="true">
  <%# Backdrop %>
  <div data-modal-target="backdrop"
       data-action="click->modal#closeOnBackdrop"
       class="absolute inset-0 bg-slate-950/35 backdrop-blur-[1px]"></div>

  <%# Modal panel %>
  <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6">
    <div data-modal-target="panel"
         tabindex="-1"
         class="relative w-full max-w-lg max-h-[85vh] overflow-y-auto rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 app-scrollbar">
      <%= turbo_frame_tag "conversation_modal" %>
    </div>
  </div>
</div>