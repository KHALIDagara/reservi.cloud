<%# Stage history timeline %>
<%# Locals: transitions, current_stage %>

<% if transitions.present? %>
  <section class="rounded-2xl border border-slate-200 bg-white p-4">
    <h4 class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Stage history</h4>
    <ol class="relative border-l-2 border-slate-200">
      <% transitions.each do |transition| %>
        <li class="mb-5 ml-4 last:mb-0">
          <div class="absolute -left-[7px] mt-1.5 size-3 rounded-full border-2 border-white bg-indigo-400"></div>
          <p class="text-xs font-semibold text-slate-700"><%= transition.from_stage&.label || "Start" %></p>
          <% if transition.from_stage %>
            <p class="mt-0.5 text-[0.65rem] text-slate-400"><%= transition.from_stage.blocks.size %> block<%= "s" unless transition.from_stage.blocks.size == 1 %></p>
          <% end %>
          <p class="mt-0.5 text-[0.62rem] text-slate-400"><%= time_ago_in_words(transition.created_at) %> ago</p>
        </li>
      <% end %>
      <% if current_stage %>
        <li class="mb-5 ml-4 last:mb-0">
          <div class="absolute -left-[7px] mt-1.5 size-3 rounded-full border-2 border-white bg-emerald-500"></div>
          <p class="text-xs font-bold text-emerald-700"><%= current_stage.label %> <span class="font-normal text-emerald-600">(current)</span></p>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>