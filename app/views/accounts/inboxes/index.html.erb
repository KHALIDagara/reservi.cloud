<div class="flex items-start justify-between gap-4">
  <div>
    <p class="text-sm font-semibold text-indigo-600">Messaging channels</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Inboxes</h1>
    <p class="mt-1 text-sm text-slate-500">Connect the places where customers message your business.</p>
  </div>
  <%= link_to new_account_inbox_connect_path(current_account), class: "inline-flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white shadow-sm shadow-indigo-200 hover:bg-indigo-700" do %>
    <%= app_icon(:plus, class_name: "size-4") %><span class="hidden sm:inline">Connect inbox</span><span class="sm:hidden">Connect</span>
  <% end %>
</div>

<% if @inboxes.any? %>
  <div class="mt-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% @inboxes.each do |inbox| %>
      <%= link_to inbox_path(current_account, inbox), class: "group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md" do %>
        <div class="flex items-start justify-between gap-3">
          <span class="flex size-11 items-center justify-center rounded-xl <%= inbox.provider_type == 'whatsapp' ? 'bg-emerald-50 text-emerald-600' : 'bg-fuchsia-50 text-fuchsia-600' %>">
            <%= app_icon(:inbox, class_name: "size-5") %>
          </span>
          <span class="rounded-full px-2.5 py-1 text-[0.68rem] font-bold <%= inbox.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= inbox.active? ? "Connected" : "Inactive" %></span>
        </div>
        <h2 class="mt-4 font-bold text-slate-900"><%= inbox.name %></h2>
        <p class="mt-1 text-sm capitalize text-slate-500"><%= inbox.provider_type %></p>
        <p class="mt-4 text-xs font-semibold text-indigo-600 group-hover:text-indigo-700">Manage inbox →</p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="mt-7 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center shadow-sm">
    <span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= app_icon(:inbox, class_name: "size-6") %></span>
    <p class="mt-4 font-bold text-slate-900">Connect your first inbox</p>
    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">Bring WhatsApp or Instagram conversations into one shared workspace.</p>
    <%= link_to "Connect inbox", new_account_inbox_connect_path(current_account), class: "mt-5 inline-flex min-h-11 items-center rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white hover:bg-indigo-700" %>
  </div>
<% end %>
