<h1 class="text-2xl font-semibold tracking-tight">Create your Reservi account</h1>

<%= form_with url: register_path, class: "mt-6 space-y-5" do |form| %>
  <div>
    <%= form.label :name, "Your name", class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :name, name: "user[name]", required: true, autofocus: true, class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
    <% if @user.errors[:name].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @user.errors[:name].to_sentence %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :email_address, "Email address", class: "mb-1 block text-sm font-medium" %>
    <%= form.email_field :email_address, name: "user[email_address]", required: true, autocomplete: "email", class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
    <% if @user.errors[:email_address].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @user.errors[:email_address].to_sentence %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :password, "Password", class: "mb-1 block text-sm font-medium" %>
    <%= form.password_field :password, name: "user[password]", required: true, autocomplete: "new-password", minlength: 8, class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
    <% if @user.errors[:password].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @user.errors[:password].to_sentence %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm password", class: "mb-1 block text-sm font-medium" %>
    <%= form.password_field :password_confirmation, name: "user[password_confirmation]", required: true, autocomplete: "new-password", class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
  </div>

  <%= form.submit "Create account", class: "w-full rounded-md bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700 sm:w-auto" %>
<% end %>

<p class="mt-6 text-sm text-stone-500">
  Already have an account?
  <%= link_to "Sign in", new_session_path, class: "text-stone-700 underline hover:text-stone-900" %>
</p>