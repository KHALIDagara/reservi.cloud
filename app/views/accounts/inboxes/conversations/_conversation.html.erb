<%# Inboxes::Conversations _conversation partial %>
<%# Locals: conversation, messages, notes, panel_open %>

<div data-controller="slide-panel"
     data-slide-panel-open-class="translate-x-0"
     data-slide-panel-closed-class="translate-x-full lg:translate-x-0"
     data-action="keydown.esc@window->slide-panel#close keydown.tab@window->slide-panel#trapFocus">
  <header class="border-b border-slate-200 bg-white px-4 py-4 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-[96rem] items-center gap-3">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-100 to-violet-100 text-sm font-bold text-indigo-700"><%= conversation.customer.name.first.upcase %></span>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <h1 class="truncate text-base font-bold text-slate-950 sm:text-lg"><%= conversation.customer.name %></h1>
          <% if conversation.attention %><span class="hidden rounded-full bg-amber-50 px-2 py-0.5 text-[0.68rem] font-bold text-amber-700 ring-1 ring-amber-100 sm:inline">Needs attention</span><% end %>
        </div>
        <p class="truncate text-xs text-slate-500 sm:text-sm"><%= conversation.current_stage&.label || "No stage" %> · <%= conversation.owner&.name || "Unassigned" %></p>
      </div>
      <div class="hidden sm:block">
        <% if conversation.unowned? %>
          <%= button_to "Claim conversation", account_conversation_claim_path(current_account, conversation), method: :post, class: "min-h-10 rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700" %>
        <% else %>
          <%= button_to "Release", account_conversation_unclaim_path(current_account, conversation), method: :post, class: "min-h-10 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-600 hover:bg-slate-50" %>
        <% end %>
      </div>
      <button type="button" data-slide-panel-target="trigger" data-action="click->slide-panel#toggle" aria-controls="conversation-work-panel" aria-expanded="false" class="flex min-h-10 shrink-0 items-center gap-2 rounded-xl bg-indigo-50 px-3 text-sm font-bold text-indigo-700 ring-1 ring-indigo-100 hover:bg-indigo-100 lg:hidden">
        <%= app_icon(:fields, class_name: "size-4") %> Work
        <% if conversation.current_stage&.blocks&.any? %><span class="rounded-full bg-indigo-600 px-1.5 py-0.5 text-[0.65rem] leading-none text-white"><%= conversation.current_stage.blocks.size %></span><% end %>
      </button>
    </div>
  </header>

  <div class="mx-auto grid max-w-[96rem] lg:grid-cols-[minmax(0,1fr)_23rem]">
    <div class="min-w-0 bg-slate-50 lg:border-r lg:border-slate-200">
      <section class="mx-auto flex min-h-[calc(100dvh-8rem)] max-w-4xl flex-col" aria-label="Conversation with <%= conversation.customer.name %>">
        <div class="app-scrollbar flex-1 space-y-4 px-4 py-6 sm:px-6 lg:px-8" id="messages_container">
          <% if local_assigns[:has_older_messages] && has_older_messages %>
            <div class="text-center pb-3">
              <%= link_to "Load older messages",
                    inbox_conversation_messages_path(current_account, @inbox, conversation, before: local_assigns[:oldest_message_id]),
                    class: "rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-500 shadow-sm hover:bg-slate-50",
                    data: { turbo_frame: "messages_container" } %>
            </div>
          <% end %>

          <% if messages.any? %>
            <% messages.each do |message| %>
              <%= render "accounts/inboxes/conversations/messages/message", message: message %>
            <% end %>
          <% else %>
            <div class="py-16 text-center">
              <span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-white text-slate-400 shadow-sm ring-1 ring-slate-200"><%= app_icon(:inbox, class_name: "size-6") %></span>
              <p class="mt-4 font-semibold text-slate-700">No messages yet</p>
              <p class="mt-1 text-sm text-slate-500">Send a message to start the conversation.</p>
            </div>
          <% end %>
        </div>

        <%# Reply composer %>
        <div class="border-y border-slate-200 bg-white p-3 sm:p-4">
          <%= form_with url: inbox_conversation_messages_path(current_account, @inbox, conversation), class: "flex items-end gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-2 focus-within:border-indigo-300 focus-within:ring-4 focus-within:ring-indigo-50" do |f| %>
            <%= f.label :content, "Reply to customer", class: "sr-only" %>
            <%= f.text_area :content, rows: 2, placeholder: "Write a reply…", required: true, class: "max-h-40 min-h-11 min-w-0 flex-1 resize-none border-0 bg-transparent px-2 py-2 text-sm leading-6 text-slate-900 outline-none placeholder:text-slate-400" %>
            <%= f.submit "Send", class: "min-h-11 shrink-0 cursor-pointer rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white shadow-sm hover:bg-indigo-700" %>
          <% end %>
          <p class="mt-2 px-1 text-xs text-slate-400">Customer-facing message</p>
        </div>

        <%# Internal notes %>
        <section class="px-4 py-6 sm:px-6 lg:px-8" aria-labelledby="notes-heading">
          <div class="flex items-center justify-between">
            <div>
              <h2 id="notes-heading" class="font-bold text-slate-900">Internal notes</h2>
              <p class="mt-0.5 text-xs text-slate-500">Only visible to your team</p>
            </div>
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700"><%= notes.size %></span>
          </div>
          <% if notes.any? %>
            <ul class="mt-3 space-y-2">
              <% notes.each do |note| %>
                <li class="rounded-xl border border-amber-100 bg-amber-50/60 px-4 py-3">
                  <p class="text-xs font-semibold text-amber-800"><%= note.agent.name %> · <%= time_ago_in_words(note.created_at) %> ago</p>
                  <p class="mt-1 whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= note.content %></p>
                </li>
              <% end %>
            </ul>
          <% end %>
          <%= form_with url: inbox_conversation_notes_path(current_account, @inbox, conversation), class: "mt-3 flex items-end gap-2" do |f| %>
            <%= f.label :content, "Internal note", class: "sr-only" %>
            <%= f.text_area :content, rows: 2, placeholder: "Add an internal note…", required: true, class: "min-h-11 min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-amber-300 focus:ring-4 focus:ring-amber-50" %>
            <%= f.submit "Add note", class: "min-h-11 shrink-0 cursor-pointer rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50" %>
          <% end %>

          <% if conversation.active? %>
            <details class="mt-8 border-t border-slate-200 pt-5">
              <summary class="cursor-pointer text-sm font-semibold text-rose-600">Cancel conversation</summary>
              <%= form_with url: account_conversation_cancel_path(current_account, conversation), method: :post, class: "mt-3 flex flex-col gap-2 sm:flex-row" do |f| %>
                <%= f.label :reason, "Cancellation reason", class: "sr-only" %>
                <%= f.text_field :reason, placeholder: "Reason for cancellation…", required: true, class: "min-h-11 min-w-0 flex-1 rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-rose-300 focus:ring-4 focus:ring-rose-50" %>
                <%= f.submit "Cancel conversation", class: "min-h-11 rounded-xl bg-rose-600 px-4 text-sm font-bold text-white hover:bg-rose-700" %>
              <% end %>
            </details>
          <% end %>
        </section>
      </section>
    </div>

    <%# ── RIGHT COLUMN: Conversation work panel ───────────────────────── %>
    <div data-slide-panel-target="overlay" data-action="click->slide-panel#close" class="fixed inset-0 z-40 hidden bg-slate-950/35 backdrop-blur-[1px] lg:hidden"></div>
    <aside id="conversation-work-panel" data-slide-panel-target="panel" aria-labelledby="work-panel-title"
           class="app-scrollbar fixed inset-y-0 right-0 z-50 w-[min(90vw,24rem)] translate-x-full overflow-y-auto border-l border-slate-200 bg-white shadow-2xl transition-transform duration-200 lg:static lg:z-auto lg:w-auto lg:translate-x-0 lg:shadow-none">
      <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-100 bg-white/95 px-5 py-4 backdrop-blur lg:hidden">
        <div>
          <h2 id="work-panel-title" class="font-bold text-slate-900">Conversation work</h2>
          <p class="text-xs text-slate-500">Complete the current stage</p>
        </div>
        <button type="button" data-slide-panel-target="closeButton" data-action="click->slide-panel#close" class="flex size-10 items-center justify-center rounded-xl bg-slate-100 text-xl text-slate-500 hover:text-slate-900" aria-label="Close work panel">×</button>
      </div>
      <%= turbo_frame_tag "conversation_panel", src: inbox_conversation_panel_path(current_account, @inbox, conversation), loading: (panel_open ? :eager : :lazy) do %>
        <div class="space-y-4 p-5" aria-live="polite">
          <div class="h-20 animate-pulse rounded-2xl bg-slate-100"></div>
          <div class="h-36 animate-pulse rounded-2xl bg-slate-100"></div>
          <p class="text-center text-xs text-slate-400">Loading conversation work…</p>
        </div>
      <% end %>
    </aside>
  </div>
</div>