<% if @items.any? %>
  <ul class="divide-y divide-stone-200">
    <% @items.each do |item| %>
      <li class="px-4 py-3">
        <p class="font-medium"><%= item.title %></p>
        <% if item.price %>
          <p class="text-sm text-stone-500"><%= number_to_currency(item.price, unit: item.currency || "USD") %><%= " / #{item.unit}" if item.unit.present? %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="p-4 text-sm text-stone-500">No items in this catalog.</p>
<% end %>