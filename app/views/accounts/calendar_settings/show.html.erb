<%= content_for :title, "My Calendar — #{current_agent.name}" %>

<div class="mx-auto max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">My Calendar</h1>
      <p class="mt-1 text-sm text-slate-500"><%= current_agent.name %></p>
    </div>
  </div>

  <% if @setting %>
    <div class="mt-6 space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-base font-bold text-slate-800">Settings</h2>
        <dl class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Timezone</dt>
            <dd class="mt-1 text-sm font-medium text-slate-800"><%= @setting.timezone %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Availability</dt>
            <dd class="mt-1 text-sm font-medium text-slate-800">
              <% day_names = { "0" => "Sun", "1" => "Mon", "2" => "Tue", "3" => "Wed", "4" => "Thu", "5" => "Fri", "6" => "Sat" } %>
              <%= (@setting.weekly_hours || {}).select { |_d, iv| iv.present? }.count %> day<%= "s" if (@setting.weekly_hours || {}).select { |_d, iv| iv.present? }.count != 1 %>
            </dd>
          </div>
        </dl>
        <div class="mt-4">
          <%= link_to "Edit settings", edit_calendar_setting_path(current_account),
                class: "min-h-10 inline-flex items-center rounded-xl border border-indigo-200 bg-white px-4 text-sm font-bold text-indigo-600 hover:bg-indigo-50" %>
        </div>
      </section>

      <%# Upcoming available days preview %>
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-base font-bold text-slate-800">Upcoming availability</h2>
        <%
          upcoming = @setting.available_days(up_to_days: 14)
          tz = @setting.active_timezone
        %>
        <% if upcoming.any? %>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <% upcoming.each do |date| %>
              <span class="min-h-9 inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs font-semibold text-slate-700">
                <%= date.strftime("%a %d %b") %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-400">No upcoming available days configured. Set your weekly hours to start receiving appointments.</p>
        <% end %>
      </section>

      <%# Exceptions %>
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-base font-bold text-slate-800">Exceptions</h2>
        <p class="mt-1 text-sm text-slate-500">Custom hours for specific days (holidays, special events).</p>
        <% exceptions = @setting.calendar_exceptions.order(date: :desc).limit(10) %>
        <% if exceptions.any? %>
          <ul class="mt-3 divide-y divide-slate-100">
            <% exceptions.each do |ex| %>
              <li class="flex items-center justify-between gap-3 py-2">
                <div>
                  <span class="text-sm font-semibold text-slate-800"><%= ex.date.strftime("%a %d %b %Y") %></span>
                  <% if ex.intervals.empty? %>
                    <span class="ml-2 rounded-full bg-rose-100 px-2 py-0.5 text-[0.68rem] font-bold text-rose-700">Closed</span>
                  <% else %>
                    <% ex.intervals.each do |pair| %>
                      <span class="ml-2 text-xs text-slate-500"><%= pair[0] %>&ndash;<%= pair[1] %></span>
                    <% end %>
                  <% end %>
                </div>
                <div class="flex gap-1 shrink-0">
                  <%= button_to "×", account_calendar_exception_path(current_account, ex),
                        method: :delete,
                        class: "flex size-7 items-center justify-center rounded-lg text-rose-600 hover:bg-rose-50",
                        form: { class: "shrink-0" },
                        aria: { label: "Remove exception for #{ex.date}" } %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-sm text-slate-400">No exceptions configured.</p>
        <% end %>
      </section>
    </div>
  <% end %>
</div>