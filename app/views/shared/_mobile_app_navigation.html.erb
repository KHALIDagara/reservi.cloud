<% unless content_for?(:hide_mobile_header) %>
<header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur lg:hidden">
  <%= link_to account_home_path(current_account), class: "flex min-w-0 items-center gap-2.5" do %>
    <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-xs font-bold text-white">R</span>
    <span class="truncate text-sm font-bold text-slate-900"><%= current_account.name %></span>
  <% end %>
  <%= link_to accounts_path, class: "flex size-10 items-center justify-center rounded-xl border border-slate-200 text-slate-500", aria: { label: "Switch account" } do %>
    <%= app_icon(:building, class_name: "size-5") %>
  <% end %>
</header>
<% end %>

<nav class="app-safe-bottom fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 border-t border-slate-200 bg-white/95 px-2 pt-1.5 shadow-[0_-8px_30px_rgba(15,23,42,0.06)] backdrop-blur lg:hidden" aria-label="Mobile navigation">
  <% [
    [ :home, "Home", account_home_path(current_account), :home ],
    [ :inbox, "Inbox", account_inbox_path(current_account), :inbox ],
    [ :new, "New", new_account_conversation_path(current_account), :plus ],
    [ :people, current_membership.admin? ? "Manage" : "Account", current_membership.admin? ? account_people_path(current_account) : accounts_path, current_membership.admin? ? :users : :building ]
  ].each do |section, label, path, icon| %>
    <% active = section == :new ? false : app_nav_active?(section) %>
    <%= link_to path, class: "flex min-h-14 flex-col items-center justify-center gap-1 rounded-xl text-[0.68rem] font-semibold #{active ? 'text-indigo-600' : 'text-slate-500'}", aria: (active ? { current: "page" } : {}) do %>
      <span class="relative"><%= app_icon(icon, class_name: "size-5") %></span>
      <span><%= label %></span>
    <% end %>
  <% end %>
</nav>
