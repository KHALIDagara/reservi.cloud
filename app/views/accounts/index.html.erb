<div class="mx-auto max-w-2xl">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold text-indigo-600">Workspaces</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Your accounts</h1>
      <p class="mt-2 text-sm text-slate-500">Choose where you want to work today.</p>
    </div>
    <%= link_to new_account_path, class: "inline-flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white shadow-sm hover:bg-indigo-700" do %>
      <%= app_icon(:plus, class_name: "size-4") %><span class="hidden sm:inline">New account</span><span class="sm:hidden">New</span>
    <% end %>
  </div>

  <% if @memberships.any? %>
    <ul class="mt-7 space-y-3">
      <% @memberships.each do |membership| %>
        <li>
          <%= link_to account_home_path(membership.account), class: "group flex min-h-20 items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md" do %>
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 font-bold text-indigo-700 ring-1 ring-indigo-100"><%= membership.account.name.first.upcase %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-bold text-slate-900"><%= membership.account.name %></span>
              <span class="mt-0.5 block text-xs font-medium capitalize text-slate-500"><%= membership.role %> workspace</span>
            </span>
            <span class="text-sm font-semibold text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-indigo-600">Open →</span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @next_cursor %>
      <p class="mt-5 text-center"><%= link_to "Show older accounts", accounts_path(before: @next_cursor), class: "text-sm font-semibold text-indigo-600" %></p>
    <% end %>
  <% else %>
    <div class="mt-7 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
      <span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= app_icon(:building, class_name: "size-6") %></span>
      <p class="mt-4 font-bold text-slate-900">Create your first workspace</p>
      <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">Accounts keep each business, team, and workflow securely separated.</p>
      <%= link_to "Create account", new_account_path, class: "mt-5 inline-flex min-h-11 items-center rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
