<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Flows</h1>
  <%= link_to "New flow", new_flow_path(current_account), class: "rounded-md bg-stone-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-stone-700" %>
</div>

<% if @flows.any? %>
  <ul class="mt-4 divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
    <% @flows.each do |flow| %>
      <li class="flex items-center justify-between px-4 py-3">
        <div class="min-w-0 flex-1">
          <p class="font-medium"><%= flow.name %></p>
          <p class="text-sm text-stone-500">
            <%= flow.versions.count %> version(s)
            <% if flow.current_version %>
              · Published v<%= flow.current_version.version_number %>
            <% end %>
          </p>
          <% if flow.versions.any? %>
            <div class="mt-1 flex flex-wrap gap-1">
              <% flow.versions.order(version_number: :desc).limit(3).each do |v| %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= v.published? ? 'bg-emerald-50 text-emerald-700' : 'bg-stone-100 text-stone-600' %>">
                  v<%= v.version_number %><%= v.published? ? " (published)" : " (draft)" %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="ml-4 flex shrink-0 gap-2">
          <% draft = flow.versions.draft.order(version_number: :desc).first %>
          <% if draft %>
            <%= link_to "Edit draft", edit_flow_flow_version_path(current_account, flow, draft), class: "rounded-md bg-stone-900 px-3 py-1 text-sm font-medium text-white hover:bg-stone-700" %>
          <% end %>
          <%= link_to "Edit", edit_flow_path(current_account, flow), class: "rounded-md border border-stone-300 px-3 py-1 text-sm text-stone-700 hover:bg-stone-100" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6 rounded-lg border border-dashed border-stone-300 bg-white p-8 text-center">
    <p class="font-medium">No flows yet</p>
    <p class="mt-1 text-sm text-stone-500">Create one to define your business process.</p>
    <%= link_to "New flow", new_flow_path(current_account), class: "mt-4 inline-block rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
  </div>
<% end %>