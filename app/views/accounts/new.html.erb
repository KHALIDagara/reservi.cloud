<h1 class="text-2xl font-semibold tracking-tight">Create an account</h1>
<p class="mt-1 text-sm text-stone-500">
  You will become its administrator. Your timezone and language default to UTC and English for now and can be changed later.
</p>

<%= form_with url: accounts_path, class: "mt-6 space-y-5" do |form| %>
  <%= hidden_field_tag "account[operation_key]", @operation_key %>
  <%= hidden_field_tag "account[timezone]", "UTC" %>
  <%= hidden_field_tag "account[locale]", "en" %>

  <div>
    <%= form.label :name, "Account name", class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :name, name: "account[name]", required: true, autofocus: true, placeholder: "e.g. Marrakech Garden", class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
    <% if defined?(@account) && @account.errors[:name].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @account.errors[:name].to_sentence %></p>
    <% end %>
  </div>

  <%= form.submit "Create account", class: "w-full rounded-md bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700 sm:w-auto" %>
<% end %>