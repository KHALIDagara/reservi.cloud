<div class="mb-4">
  <%= link_to "← Back to inbox", account_inbox_path(current_account), class: "text-sm text-stone-500 hover:text-stone-900" %>
</div>

<h1 class="text-2xl font-semibold tracking-tight">New conversation</h1>

<%= form_with url: account_conversations_path(current_account), scope: :conversation, class: "mt-6 space-y-5" do |f| %>
  <div>
    <%= f.label :name, "Customer name", class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :email_address, "Email address", class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email_address, class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :phone, "Phone number", class: "mb-1 block text-sm font-medium" %>
    <%= f.telephone_field :phone, class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :initial_message, "Initial message", class: "mb-1 block text-sm font-medium" %>
    <%= f.text_area :initial_message, rows: 3, required: true, placeholder: "How did the customer reach out?", class: "w-full rounded-md border border-stone-300 px-3 py-2 focus:border-stone-500 focus:outline-none" %>
  </div>

  <%= f.submit "Create conversation", class: "w-full rounded-md bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700 sm:w-auto" %>
<% end %>