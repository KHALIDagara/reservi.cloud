<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Your accounts</h1>
  <%= link_to "New account", new_account_path, class: "rounded-md bg-stone-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-stone-700" %>
</div>

<% if @memberships.any? %>
  <ul class="mt-6 divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
    <% @memberships.each do |membership| %>
      <li>
        <%= link_to account_home_path(membership.account), class: "flex items-center justify-between gap-3 px-4 py-3 hover:bg-stone-50" do %>
          <div class="min-w-0">
            <p class="truncate font-medium"><%= membership.account.name %></p>
            <p class="text-sm text-stone-500"><%= membership.role %></p>
          </div>
          <span class="shrink-0 text-sm text-stone-400">Open →</span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @next_cursor %>
    <p class="mt-4 text-sm">
      <%= link_to "Older accounts", accounts_path(before: @next_cursor), class: "text-stone-600 underline hover:text-stone-900" %>
    </p>
  <% end %>
<% else %>
  <div class="mt-6 rounded-lg border border-dashed border-stone-300 bg-white p-8 text-center">
    <p class="font-medium">Reservi keeps every business in its own Account.</p>
    <p class="mt-1 text-sm text-stone-500">Create one to set up your teams, people and workflow.</p>
    <%= link_to "Create your first account", new_account_path, class: "mt-4 inline-block rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
  </div>
<% end %>