<div class="mb-4">
  <%= link_to "← Back to inbox", account_inbox_path(current_account), class: "text-sm text-stone-500 hover:text-stone-900" %>
</div>

<div class="rounded-lg border border-stone-200 bg-white">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-stone-200 px-4 py-3">
    <div>
      <h1 class="text-lg font-semibold"><%= @conversation.customer.name %></h1>
      <p class="text-sm text-stone-500">
        <%= @conversation.current_stage.label %>
        <% if @conversation.owner.present? %>
          · <%= @conversation.owner.name %>
        <% else %>
          · Unowned
        <% end %>
        <% if @conversation.cancelled? %>
          · Cancelled
        <% elsif @conversation.process_status == "completed" %>
          · Completed
        <% end %>
      </p>
    </div>
    <div class="flex gap-2">
      <% if @conversation.unowned? %>
        <%= button_to "Claim", account_conversation_claim_path(current_account, @conversation), method: :post, class: "rounded-md bg-stone-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-stone-700" %>
      <% else %>
        <%= button_to "Release", account_conversation_unclaim_path(current_account, @conversation), method: :post, class: "rounded-md border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-50" %>
      <% end %>
    </div>
  </div>

  <!-- Messages -->
  <div class="space-y-3 px-4 py-4">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="<%= message.direction == "inbound" ? "pr-12" : "pl-12" %>">
          <div class="rounded-lg <%= message.direction == "inbound" ? "bg-stone-100" : "bg-stone-900 text-white" %> px-3 py-2">
            <p class="text-xs <%= message.direction == "inbound" ? "text-stone-500" : "text-stone-300" %>"><%= message.author_name %></p>
            <p class="mt-0.5 text-sm whitespace-pre-wrap"><%= message.content %></p>
            <p class="mt-0.5 text-xs <%= message.direction == "inbound" ? "text-stone-400" : "text-stone-400" %>"><%= time_ago_in_words(message.created_at) %> ago</p>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="py-4 text-center text-sm text-stone-400">No messages yet.</p>
    <% end %>
  </div>

  <!-- Reply form -->
  <div class="border-t border-stone-200 px-4 py-3">
    <%= form_with url: account_conversation_messages_path(current_account, @conversation), class: "flex gap-2" do |f| %>
      <%= f.text_area :content, rows: 2, placeholder: "Type your reply...", required: true, class: "min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
      <%= f.submit "Send", class: "shrink-0 self-end rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
    <% end %>
  </div>
</div>

<!-- Notes -->
<div class="mt-6">
  <h2 class="text-lg font-semibold">Notes</h2>
  <% if @notes.any? %>
    <ul class="mt-2 divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
      <% @notes.each do |note| %>
        <li class="px-4 py-3">
          <p class="text-xs text-stone-500"><%= note.agent.name %> · <%= time_ago_in_words(note.created_at) %> ago</p>
          <p class="mt-1 text-sm whitespace-pre-wrap"><%= note.content %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-stone-400">No notes yet.</p>
  <% end %>

  <!-- New note form -->
  <div class="mt-3">
    <%= form_with url: account_conversation_notes_path(current_account, @conversation), class: "flex gap-2" do |f| %>
      <%= f.text_area :content, rows: 2, placeholder: "Add an internal note...", required: true, class: "min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
      <%= f.submit "Add note", class: "shrink-0 self-end rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50" %>
    <% end %>
  </div>
</div>

<!-- Cancel -->
<% if @conversation.active? %>
  <div class="mt-6 border-t border-stone-200 pt-4">
    <details class="group">
      <summary class="cursor-pointer text-sm text-red-600 hover:text-red-700">Cancel this conversation</summary>
      <div class="mt-2">
        <%= form_with url: account_conversation_cancel_path(current_account, @conversation), method: :post, class: "flex gap-2" do |f| %>
          <%= f.text_field :reason, placeholder: "Reason for cancellation...", required: true, class: "min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
          <%= f.submit "Cancel conversation", class: "shrink-0 rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>
        <% end %>
      </div>
    </details>
  </div>
<% end %>