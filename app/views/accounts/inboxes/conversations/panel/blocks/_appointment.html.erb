<%# Appointment block — shows booked appointments for each role key %>
<%# Locals: block, conversation, appointments %>

<% return if (appointments || {}).empty? && block["role_key"].blank? %>

<% role = block["role_key"] %>
<% appt = appointments[role] if appointments %>

<div class="rounded-2xl border border-slate-200 bg-white p-4">
  <h4 class="mb-4 text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Appointment</h4>

  <p class="text-xs font-bold text-slate-600"><%= role.titleize %></p>

  <% if appt&.confirmed? %>
    <%# Existing confirmed appointment %>
    <div class="mt-2 rounded-xl bg-emerald-50 p-3">
      <div class="flex items-start justify-between gap-2">
        <div>
          <p class="text-sm font-semibold text-emerald-800">
            <%= appt.starts_at.in_time_zone(appt.timezone)&.strftime("%a, %d %b · %H:%M") %>
            &mdash;
            <%= (appt.starts_at + (appt.duration_minutes || 60).minutes).in_time_zone(appt.timezone)&.strftime("%H:%M") %>
          </p>
          <% if appt.scheduled_agent %>
            <p class="mt-0.5 text-xs text-emerald-600">
              With <span class="font-semibold"><%= appt.scheduled_agent.name %></span>
            </p>
          <% end %>
          <p class="mt-0.5 text-xs text-emerald-500"><%= appt.timezone %></p>
        </div>
        <span class="rounded-full bg-emerald-200 px-2 py-0.5 text-[0.68rem] font-bold text-emerald-800">Confirmed</span>
      </div>
    </div>

  <% elsif appt %>
    <%# Existing non-confirmed appointment %>
    <div class="mt-2 rounded-xl bg-amber-50 p-3">
      <p class="text-sm font-semibold text-amber-800">
        <%= appt.starts_at.in_time_zone(appt.timezone)&.strftime("%a, %d %b · %H:%M") %>
      </p>
      <p class="mt-0.5 text-xs text-amber-600"><%= appt.status&.humanize || "Pending" %></p>
    </div>

  <% else %>
    <%# No appointment scheduled — show empty state %>
    <p class="mt-1.5 text-sm italic text-slate-400">
      Not booked
      <span class="ml-1 text-slate-300">○</span>
    </p>
  <% end %>

  <%# Book/reschedule action %>
  <div class="mt-3">
    <%= link_to appt ? "Reschedule" : "Book appointment",
          new_account_conversation_path(current_account),
          data: { turbo_frame: "conversation_modal" },
          class: "inline-flex min-h-9 items-center rounded-lg border border-indigo-200 bg-white px-3 text-xs font-bold text-indigo-600 hover:bg-indigo-50" %>
  </div>
</div>