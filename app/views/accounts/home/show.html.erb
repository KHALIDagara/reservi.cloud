<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="text-sm font-semibold text-indigo-600">Workspace overview</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Good to see you, <%= Current.user.name.split.first %></h1>
    <p class="mt-2 text-sm text-slate-500">Here’s what needs attention across <%= current_account.name %>.</p>
  </div>
  <%= link_to new_account_conversation_path(current_account), class: "inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-200 transition hover:bg-indigo-700" do %>
    <%= app_icon(:plus, class_name: "size-4") %> New conversation
  <% end %>
</div>

<section class="mt-7 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Conversation summary">
  <% [
    [ "Needs attention", @attention_count, account_inbox_path(current_account), "bg-amber-50 text-amber-700 ring-amber-100" ],
    [ "Assigned to me", @mine_count, account_inbox_path(current_account, filter: "mine"), "bg-indigo-50 text-indigo-700 ring-indigo-100" ],
    [ "Unassigned", @unowned_count, account_inbox_path(current_account, filter: "unowned"), "bg-rose-50 text-rose-700 ring-rose-100" ],
    [ "Active", @active_count, account_inbox_path(current_account), "bg-emerald-50 text-emerald-700 ring-emerald-100" ]
  ].each do |label, count, path, color| %>
    <%= link_to path, class: "group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md sm:p-5" do %>
      <span class="inline-flex rounded-lg px-2 py-1 text-xs font-bold ring-1 <%= color %>"><%= label %></span>
      <span class="mt-4 block text-3xl font-bold tracking-tight text-slate-950"><%= count %></span>
      <span class="mt-1 block text-xs font-medium text-slate-400 group-hover:text-indigo-600">View conversations →</span>
    <% end %>
  <% end %>
</section>

<div class="mt-7 grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-4 sm:px-5">
      <div>
        <h2 class="font-bold text-slate-900">Recent conversations</h2>
        <p class="mt-0.5 text-xs text-slate-500">Your latest customer activity</p>
      </div>
      <%= link_to "Open inbox", account_inbox_path(current_account), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
    </div>
    <% if @recent_conversations.any? %>
      <ul class="divide-y divide-slate-100">
        <% @recent_conversations.each do |conversation| %>
          <li>
            <%= link_to account_conversation_path(current_account, conversation), class: "flex items-center gap-3 px-4 py-3.5 transition hover:bg-slate-50 sm:px-5" do %>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600"><%= conversation.customer.name.first.upcase %></span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-2">
                  <span class="truncate text-sm font-semibold text-slate-900"><%= conversation.customer.name %></span>
                  <% if conversation.attention %><span class="size-2 shrink-0 rounded-full bg-amber-400" aria-label="Needs attention"></span><% end %>
                </span>
                <span class="mt-0.5 block truncate text-xs text-slate-500"><%= conversation.current_stage&.label || "No stage" %> · <%= conversation.owner&.name || "Unassigned" %></span>
              </span>
              <span class="shrink-0 text-xs text-slate-400"><%= time_ago_in_words(conversation.last_activity_at || conversation.created_at) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="font-semibold text-slate-800">Your workspace is ready</p>
        <p class="mt-1 text-sm text-slate-500">Create a conversation to start turning requests into work.</p>
      </div>
    <% end %>
  </section>

  <% if current_membership.admin? %>
    <aside class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-bold text-slate-900">Workspace setup</h2>
      <p class="mt-1 text-xs leading-5 text-slate-500">Configure how your team handles customer work.</p>
      <div class="mt-4 space-y-2">
        <% [
          [ "Inboxes", "Connect WhatsApp or Instagram", account_channels_path(current_account), :inbox ],
          [ "People & AI", "Manage your team", account_people_path(current_account), :users ],
          [ "Flows", "Design your process", flows_path(current_account), :flow ],
          [ "Catalogs", "Organize what you offer", catalogs_path(account_id: current_account), :catalog ],
          [ "Fields", "Structure customer facts", account_field_definitions_path(current_account), :fields ]
        ].each do |title, description, path, icon| %>
          <%= link_to path, class: "flex items-center gap-3 rounded-xl border border-transparent p-2.5 transition hover:border-slate-200 hover:bg-slate-50" do %>
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><%= app_icon(icon, class_name: "size-4") %></span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-slate-800"><%= title %></span>
              <span class="block text-xs text-slate-500"><%= description %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    </aside>
  <% end %>
</div>
