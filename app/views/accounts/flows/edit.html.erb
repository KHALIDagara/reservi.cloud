<h1 class="text-2xl font-semibold tracking-tight">Edit flow</h1>

<%= form_with model: @flow, url: flow_path(current_account, @flow), method: :patch, local: true, class: "mt-6 space-y-4" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_field :name, required: true, class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 text-sm shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "Update flow", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
    <%= link_to "Cancel", flows_path(current_account), class: "text-sm text-stone-600 hover:text-stone-900" %>
  </div>
<% end %>

<div class="mt-10">
  <h2 class="text-lg font-semibold tracking-tight">Versions</h2>

  <% if @versions.any? %>
    <ul class="mt-4 divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
      <% @versions.each do |version| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium">Version <%= version.version_number %></p>
            <p class="text-sm text-stone-500">
              <%= version.published? ? "Published #{time_ago_in_words(version.published_at)} ago" : "Draft" %>
              · <%= version.stages.count %> stage(s)
            </p>
          </div>
          <div class="flex gap-2">
            <% if version.draft? %>
              <%= link_to "Edit", edit_flow_flow_version_path(current_account, @flow, version), class: "rounded-md bg-stone-900 px-3 py-1 text-sm font-medium text-white hover:bg-stone-700" %>
            <% else %>
              <%= link_to "View", edit_flow_flow_version_path(current_account, @flow, version), class: "rounded-md border border-stone-300 px-3 py-1 text-sm text-stone-700 hover:bg-stone-100" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-stone-500">No versions yet.</p>
  <% end %>

  <%= link_to "New version", new_flow_flow_version_path(current_account, @flow), class: "mt-4 inline-block rounded-md border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-100" %>
</div>