<h1 class="text-2xl font-semibold tracking-tight"><%= current_account.name %></h1>
<p class="mt-1 text-sm text-stone-500">Account home · <%= current_membership.role %></p>

<div class="mt-6 grid gap-3 sm:grid-cols-2">
  <%= link_to account_people_path(current_account), class: "rounded-lg border border-stone-200 bg-white p-4 hover:bg-stone-50" do %>
    <p class="font-medium">People &amp; AI</p>
    <p class="mt-1 text-sm text-stone-500">Members, human and AI teammates, invitations.</p>
  <% end %>

  <div class="rounded-lg border border-stone-200 bg-white p-4 opacity-60">
    <p class="font-medium">Inbox</p>
    <p class="mt-1 text-sm text-stone-500">Arrives with the conversation workspace milestone.</p>
  </div>

  <div class="rounded-lg border border-stone-200 bg-white p-4 opacity-60">
    <p class="font-medium">Flow</p>
    <p class="mt-1 text-sm text-stone-500">Stage builder arrives with the Flow milestone.</p>
  </div>

  <div class="rounded-lg border border-stone-200 bg-white p-4 opacity-60">
    <p class="font-medium">Calendar</p>
    <p class="mt-1 text-sm text-stone-500">Appointments arrive with the scheduling milestone.</p>
  </div>
</div>